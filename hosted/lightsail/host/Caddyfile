{
    auto_https disable_redirects
}

{$VERIFY_HOSTNAME} {
    # Preissued certificate for the real hostname; independently tested renewal is required.
    # A validated DNS-01 renewal process must be installed before production cutover.
    tls /etc/verify/tls/fullchain.pem /etc/verify/tls/privatekey.pem
    reverse_proxy 127.0.0.1:8080
    header Strict-Transport-Security "max-age=31536000"
}
