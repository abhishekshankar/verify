# Nonsecret settings only. No values copied from the source environment.
PYTHONPATH=/opt/verify/current/src:/opt/verify/current
PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1
VERIFY_BIND=127.0.0.1
VERIFY_DB_HOST=localhost
VERIFY_DB_PORT=5432
VERIFY_DB_NAME=verify
VERIFY_DB_USER=verify_runtime
VERIFY_DB_SSLMODE=verify-full
VERIFY_DB_SSLROOTCERT=/etc/verify/tls/postgres-ca.pem
# Preserve the existing pool default until the rehearsal demonstrates safe sizing.
VERIFY_DB_POOL=10
