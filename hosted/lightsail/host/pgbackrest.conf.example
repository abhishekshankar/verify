# Fill in privately, root:postgres mode0640. Never commit a populated file.
[verify]
pg1-path=/var/lib/postgresql/16/main
pg1-socket-path=/var/run/postgresql

[global]
repo1-type=s3
repo1-s3-region=us-west-2
repo1-s3-endpoint=s3.us-west-2.amazonaws.com
repo1-s3-bucket=REQUIRED_PRIVATE_BACKUP_BUCKET
repo1-path=/verify-ledger
repo1-s3-key=REQUIRED_RESTRICTED_BACKUP_ACCESS_KEY
repo1-s3-key-secret=REQUIRED_RESTRICTED_BACKUP_SECRET
repo1-cipher-type=aes-256-cbc
repo1-cipher-pass=REQUIRED_BACKUP_CIPHER_KEY_STORED_SEPARATELY
repo1-retention-full-type=time
repo1-retention-full=7
compress-type=gz
process-max=1
start-fast=y
log-level-console=warn
log-level-file=warn
# Default archive retention follows the retained full backups; do not prune WAL independently.
