[Unit]
Description=Verify encrypted PostgreSQL base backup
After=postgresql@16-main.service network-online.target
Requires=postgresql@16-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
UMask=0077
ExecStart=/usr/bin/pgbackrest --stanza=verify --type=full backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
